# Datos de afiliado de Mercado Libre Chile.
# Genera un link en la Central de Afiliados y copia matt_tool / matt_word.
VITE_ML_MATT_TOOL=
VITE_ML_MATT_WORD=

# Token opcional de developers.mercadolibre.com (solo servidor, no VITE_).
# La búsqueda pública a veces responde 403; con token suele abrir.
ML_ACCESS_TOKEN=

# Comisión estimada para mostrar en la UI (referencial, no oficial).
VITE_ESTIMATED_COMMISSION=0.05

# Firebase (opcional). Sin esto, favoritos y clics se guardan en el navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
